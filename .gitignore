# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/


# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
data/

# source media archives — kept locally, far too large for git
/experiments/
/gatherings/
/works/
/ref/

# working notes / specs / plans
/docs/

# stray media at repo root (personal photos, screen recordings)
/*.mov
/*.MOV
/*.jpg
/*.JPG

# Videos in /public are committed as web-compressed MP4s (H.264, ≤1920px,
# no audio, faststart) so they deploy with the site. Raw masters (.mov and
# full-size exports) live outside the repo in
# "../New Website - video originals". Keep each MP4 well under 100 MB.
public/**/*.mov
public/**/*.MOV
